{
  "name": "pixi-effects",
  "version": "1.0.0",
  "description": "Declarative composition and video rendering for the web. Built on PixiJS v8.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./controller": {
      "import": {
        "types": "./dist/controller.d.ts",
        "default": "./dist/controller.js"
      },
      "require": {
        "types": "./dist/controller.d.cts",
        "default": "./dist/controller.cjs"
      }
    },
    "./loader.css": "./dist/loader.css",
    "./present": {
      "import": {
        "types": "./dist/present.d.ts",
        "default": "./dist/present.js"
      },
      "require": {
        "types": "./dist/present.d.cts",
        "default": "./dist/present.cjs"
      }
    },
    "./3d": {
      "import": {
        "types": "./dist/3d.d.ts",
        "default": "./dist/3d.js"
      },
      "require": {
        "types": "./dist/3d.d.cts",
        "default": "./dist/3d.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pixi-effects": "ai/tools/pixi-effects.mjs"
  },
  "files": [
    "dist",
    "ai",
    "skills",
    "docs/dsl.md",
    "docs/api.md",
    "docs/media.md",
    "llms.txt",
    "llms-full.txt",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pixi",
    "pixijs",
    "video",
    "composition",
    "compositing",
    "rendering",
    "after-effects",
    "motion-graphics",
    "timeline",
    "webgl",
    "keyframe",
    "typescript",
    "pixijs-3d"
  ],
  "license": "MIT",
  "author": {
    "name": "tefista",
    "email": "tefista.dev@gmail.com",
    "url": "https://x.com/t_yjm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjmtmtk/pixi-effects.git"
  },
  "homepage": "https://github.com/yjmtmtk/pixi-effects#readme",
  "bugs": {
    "url": "https://github.com/yjmtmtk/pixi-effects/issues"
  },
  "sideEffects": [
    "./dist/loader.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:fast": "SKIP_BROWSER_TESTS=1 vitest run",
    "test:webgl": "PE_BACKEND=webgl vitest run",
    "test:films": "vitest run tests/films",
    "test:site": "vitest run tests/site",
    "release:check": "node scripts/release-check.mjs",
    "post-publish:check": "node scripts/post-publish-check.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "site": "node scripts/preview-site.mjs",
    "site:sync": "node scripts/sync-site.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:ai": "node scripts/build-llms.mjs",
    "prepublishOnly": "node scripts/release-check.mjs --gate"
  },
  "dependencies": {
    "mediabunny": "^1.61.3"
  },
  "peerDependencies": {
    "@pixi/3d": "^0.1.0",
    "pixi-filters": "^6.1.0",
    "pixi.js": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@pixi/3d": {
      "optional": true
    },
    "pixi-filters": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pixi/3d": "^0.1.0",
    "gsap": "3.15.0",
    "happy-dom": "^15.0.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.23.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
