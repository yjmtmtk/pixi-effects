{
  "name": "pixi-effects",
  "version": "0.18.0",
  "description": "Declarative composition and video rendering for the web. Built on PixiJS v8.",
  "type": "module",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./controller": {
      "import": { "types": "./dist/Controller.d.ts", "default": "./dist/Controller.js" },
      "require": { "types": "./dist/Controller.d.cts", "default": "./dist/Controller.cjs" }
    },
    "./loader.css": "./dist/loader.css",
    "./presenter": {
      "import": { "types": "./dist/Presenter.d.ts", "default": "./dist/Presenter.js" },
      "require": { "types": "./dist/Presenter.d.cts", "default": "./dist/Presenter.cjs" }
    },
    "./three": {
      "import": { "types": "./dist/three.d.ts", "default": "./dist/three.js" },
      "require": { "types": "./dist/three.d.cts", "default": "./dist/three.cjs" }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "pixi-effects-check": "ai/tools/check.mjs", "pixi-effects-render": "ai/tools/render.mjs", "pixi-effects-view": "ai/tools/view.mjs" },
  "files": ["dist", "ai", "docs/dsl.md", "docs/api.md", "llms.txt", "llms-full.txt", "CHANGELOG.md", "README.md", "LICENSE"],
  "keywords": [
    "pixi", "pixijs", "video", "composition", "compositing", "rendering",
    "after-effects", "motion-graphics", "timeline", "webgl", "gsap", "keyframe", "typescript",
    "three", "threejs"
  ],
  "license": "MIT",
  "author": "tefista <tefista.dev@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/yjmtmtk/pixi-effects.git" },
  "homepage": "https://github.com/yjmtmtk/pixi-effects#readme",
  "bugs": { "url": "https://github.com/yjmtmtk/pixi-effects/issues" },
  "sideEffects": [
    "./dist/loader.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:fast": "SKIP_BROWSER_TESTS=1 vitest run",
    "release:check": "node scripts/release-check.mjs",
    "site": "node scripts/preview-site.mjs",
    "site:sync": "node scripts/sync-site.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:ai": "node scripts/build-llms.mjs",
    "build:gallery": "node scripts/build-gallery.mjs",
    "posters": "node scripts/make-posters.mjs",
    "guide": "node scripts/build-guide.mjs guide-preview",
    "prepublishOnly": "node scripts/release-check.mjs --gate"
  },
  "dependencies": {
    "mediabunny": "^1.61.3"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "pixi.js": "^8.0.0",
    "three": ">=0.150.0",
    "pixi-filters": "^6.1.0"
  },
  "peerDependenciesMeta": {
    "three": { "optional": true },
    "pixi-filters": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "happy-dom": "^15.0.0",
    "gsap": "^3.12.0",
    "marked": "^18.0.14",
    "pixi.js": "^8.22.0",
    "pixi-filters": "^6.1.5",
    "three": "^0.185.1",
    "@types/three": "^0.185.0"
  },
  "engines": { "node": ">=18" }
}
