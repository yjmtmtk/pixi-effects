@@ -629,10 +629,18 @@ export class Movie {
     if (!app?.renderer) return;
     if (!this._synced) this._rootSequence?.syncFrame();           // normally _updateSpace() has already done it (see there)
     this._synced = false;
+    this._feedTime(app.stage, this._timeOf(this.currentFrame));
     Culler.shared.cull(app.stage, app.renderer.screen, false);
     app.renderer.render({ container: app.stage });
   }
 
+  /** Tell time-driven filters (`grain`) which moment is about to be drawn. */
+  private _feedTime(node: Container, t: number): void {
+    const fl = node.filters as unknown as Array<{ setTime?: (t: number) => void }> | null;
+    if (Array.isArray(fl)) for (const f of fl) if (typeof f.setTime === 'function') f.setTime(t);
+    for (const c of node.children) this._feedTime(c as Container, t);
+  }
+
   private _requireReady(what: string): void {
     if (this._initState !== 'ready' || !this._rootSequence || !this.app) {
       throw new Error(`pixi-effects: movie.${what}() needs a ready movie — await movie.init(...) first`);
