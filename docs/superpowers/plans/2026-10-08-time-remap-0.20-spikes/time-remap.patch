+  /**
+   * SPIKE: time remap. `warp` maps the movie's time to the time `start` / `end` / `volumeKeyframes` are measured in (a remapped composition's
+   * local time); NaN where it is silent. `sourceMap` maps that time to a position in the sound (the layer's own speed / `time`); absent: the
+   * sound plays straight from `start`. The mixer resamples through them, so a speed other than 1 changes the pitch.
+   */
+  warp?: (t: number) => number;
+  sourceMap?: (u: number) => number;
 }
