+const BASIC = ['normal', 'add', 'screen', 'multiply'];
+const ADVANCED = ['overlay', 'soft-light', 'hard-light', 'color-dodge', 'color-burn', 'darken', 'lighten', 'difference', 'exclusion', 'hue', 'saturation', 'color', 'luminosity', 'linear-burn'];
+const MODES = [...BASIC, ...ADVANCED];
+
+/** Does any layer of this composition use an advanced blend (one that needs the backdrop)? */
+export function usesAdvancedBlend(spec: unknown): boolean {
+  let yes = false;
+  const visit = (n: unknown): void => {
+    if (yes || !n || typeof n !== 'object') return;
+    if (Array.isArray(n)) { n.forEach(visit); return; }
+    const o = n as Record<string, unknown>;
+    if (typeof o.blendMode === 'string' && ADVANCED.includes(o.blendMode)) { yes = true; return; }
+    visit(o.sequences); visit(o.mask);
+  };
+  visit(spec);
+  return yes;
+}
 
